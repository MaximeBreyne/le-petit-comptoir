{
  "name": "le-petit-comptoir-bar",
  "version": "0.7.4",
  "description": "Jeu de gestion de bar hors ligne",
  "author": "Le Petit Comptoir",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node check-game.cjs && node --test checks/updater.cjs checks/local-update-source.cjs checks/desktop-menu.cjs checks/release-cleanup.cjs checks/build-windows.cjs checks/service-engine.cjs checks/renderer.cjs",
    "dist:win": "node scripts/build-windows.cjs",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "be.lepetitcomptoir.bar",
    "productName": "Le Petit Comptoir - Bar",
    "publish": {
      "provider": "generic",
      "url": "http://127.0.0.1:1/updates/"
    },
    "extraResources": [
      {
        "from": ".build/local-update-source.json",
        "to": "local-update-source.json"
      }
    ],
    "directories": {
      "output": "release-final"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "dist/assets/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Le-Petit-Comptoir-Bar-${version}-Setup.${ext}",
      "installerIcon": "dist/assets/brand/icon.ico",
      "uninstallerIcon": "dist/assets/brand/icon.ico",
      "installerHeaderIcon": "dist/assets/brand/icon.ico"
    }
  }
}
